<body>
<div id="head">Dildar Magsi AI</div>
<div id="chat"><div class="msg ai">سلام! لکھو میں گوگل پر اندر ہی سرچ کر دوں گا۔</div></div>
<div id="googleBox"><div style="background:#075e54;padding:8px;display:flex;justify-content:space-between;color:#fff"><span>Google Result</span><button onclick="document.getElementById('googleBox').style.display='none'" style="background:red;color:white;border:none;padding:5px 10px;border-radius:5px">X</button></div><iframe id="gframe"></iframe></div>
<div id="box"><input id="t" placeholder="یہاں لکھیں..."><button onclick="go()" style="background:#128c7e;border:none;color:white;padding:12px 16px;border-radius:50%;margin-right:6px">➤</button></div>
<script>
function go(){
let q=document.getElementById('t').value.trim(); if(!q) return;
let c=document.getElementById('chat'); c.innerHTML+=`<div class=msg user>${q}</div>`;
c.innerHTML+=`<div class=msg ai>میں "${q}" سرچ کر رہا ہوں...</div>`;
document.getElementById('t').value='';
document.getElementById('googleBox').style.display='flex';
document.getElementById('gframe').src="https://www.google.com/search?q="+encodeURIComponent(q)+"&igu=1";
}
</script>
</body>
</html>